import { ResumeData } from "../types/resume";
import { Mail, Phone, MapPin } from "lucide-react";

interface ResumePreviewProps {
  data: ResumeData;
}

export default function ResumePreview({ data }: ResumePreviewProps) {
  const {
  personalInfo = {},
  experiences = [],
  education = [],
  skills = [],
} = data || {};

  return (
    <div className="bg-white rounded-lg shadow-2xl px-8 pt-2 pb-6 min-h-[800px] w-full font-serif">

      {/* Header */}
      <header className="border-b-2 border-amber-500 pb-4 mb-6">
        <h1 className="text-[26px] font-bold text-slate-800 tracking-tight" style={{ fontFamily: "'Crimson Pro', serif" }}>
          {personalInfo.fullName || "Your Name"}
        </h1>

        <div className="flex flex-wrap gap-4 mt-3 text-sm text-slate-600">
          {personalInfo.email && (
            <span className="flex items-center gap-1.5">
              <Mail className="w-3.5 h-3.5 text-amber-600" />
              {personalInfo.email}
            </span>
          )}

          {personalInfo.phone && (
            <span className="flex items-center gap-1.5">
              <Phone className="w-3.5 h-3.5 text-amber-600" />
              {personalInfo.phone}
            </span>
          )}

          {personalInfo.location && (
            <span className="flex items-center gap-1.5">
              <MapPin className="w-3.5 h-3.5 text-amber-600" />
              {personalInfo.location}
            </span>
          )}
        </div>
      </header>

      {/* Summary */}
      <section className="mb-6">
        {personalInfo.summary ? (
          <p className="text-slate-600 text-sm leading-relaxed">
            {personalInfo.summary}
          </p>
        ) : (
          <p className="text-slate-400 text-sm">No summary added</p>
        )}
      </section>

  {/* Skills */}
      <section>
      <h2 className="text-[16px] font-bold text-slate-800 border-b border-slate-200 pb-1 mb-3 uppercase tracking-wider">
          Skills
        </h2>

        {skills.length === 0 ? (
          <p className="text-slate-400 text-sm">No skills added</p>
        ) : (
          <div className="flex flex-wrap gap-2">
            {skills.map((skill, index) => (
              <span
                key={index}
                className="px-2 py-1 text-black text-xs border border-gray-300 rounded"
              >
                {skill}
              </span>
            ))}
          </div>
        )}
      </section>

      {/* Experience */}
      <section className="mb-6">
        <h2 className="text-[16px] font-bold text-slate-800 border-b border-slate-200 pb-1 mb-3 uppercase tracking-wider">         
          Experience
        </h2>

        {experiences.length === 0 ? (
          <p className="text-slate-400 text-sm">No experience added</p>
        ) : (
          <div className="space-y-4">
            {experiences.map((exp) => (
              <div key={exp.id}>
                <div className="flex justify-between items-baseline">
                  <h3 className="font-semibold text-slate-800">{exp.position}</h3>
                  <span className="text-xs text-slate-500">
                    {exp.startDate} — {exp.endDate || "Present"}
                  </span>
                </div>

                <p className="text-amber-700 text-sm font-medium">{exp.company}</p>

                {exp.description && (
                  <p className="text-slate-600 text-sm mt-1 leading-relaxed">
                    {exp.description}
                  </p>
                )}
              </div>
            ))}
          </div>
        )}
      </section>

      {/* Education */}
      <section className="mb-6">
       <h2 className="text-[16px] font-bold text-slate-800 border-b border-slate-200 pb-1 mb-3 uppercase tracking-wider">
          Education
        </h2>

        {education.length === 0 ? (
          <p className="text-slate-400 text-sm">No education added</p>
        ) : (
          <div className="space-y-3">
            {education.map((edu) => (
              <div key={edu.id}>
                <div className="flex justify-between items-baseline">
                  <h3 className="font-semibold text-slate-800">{edu.school}</h3>
                  <span className="text-xs text-slate-500">
                    {edu.graduationDate}
                  </span>
                </div>

                <p className="text-slate-600 text-sm">
                  {edu.degree} {edu.field && `in ${edu.field}`}
                </p>
              </div>
            ))}
          </div>
        )}
      </section>

    </div>
  );
}